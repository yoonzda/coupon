# =====================================================
# 옹진관광 쿠폰 플랫폼 환경변수 템플릿
# 이 파일을 복사하여 .env 로 저장 후 실제 값 입력
# =====================================================

# 서버
NODE_ENV=development
PORT=3010

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=ongjin_user
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=ongjin_coupon_db

# JWT
JWT_SECRET=CHANGE_THIS_TO_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# 암호화 Salt (전화번호 단방향 암호화용)
APP_PHONE_SALT=CHANGE_THIS_TO_RANDOM_SALT_32CHARS

# CORS 허용 Origin
CORS_ORIGIN=http://121.125.61.114

# 카카오 OAuth
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
KAKAO_CALLBACK_URL=http://121.125.61.114/auth/kakao/callback

# 네이버 OAuth
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_CALLBACK_URL=http://121.125.61.114/auth/naver/callback

# 구글 OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://121.125.61.114/auth/google/callback

# NHN Cloud SMS (카카오 비즈메시지 개설 전 임시)
NHN_SMS_APP_KEY=YOUR_NHN_APP_KEY
NHN_SMS_SECRET_KEY=YOUR_NHN_SECRET_KEY
NHN_SMS_SENDER=YOUR_REGISTERED_SENDER_NUMBER

# 카카오맵
KAKAO_MAP_API_KEY=YOUR_KAKAO_MAP_JAVASCRIPT_KEY

# 정산 스케줄 (매월 1일 00:00)
SETTLEMENT_CRON=0 0 1 * *

# 관리자 이메일 (정산 파일 생성 알림)
ADMIN_EMAIL=admin@example.com
